function save(){
  try{localStorage.setItem(SK, JSON.stringify(_programs));}catch(e){}
}

function loadAll(){
  try{
    const raw = localStorage.getItem(SK);
    if(raw) _programs = JSON.parse(raw);
  }catch(e){}
  // Always ensure Chase exists
  if(!_programs['chase_powers']){
    _programs['chase_powers'] = JSON.parse(JSON.stringify(CHASE_DEFAULT));
    save();
  }
}

async function loadApiKey(){
  for(const k of API_KEY_SOURCES){
    const v = localStorage.getItem(k);
    if(v && v.length > 10){ _apiKey = v; break; }
  }
  // Also try storage shim
  try{
    const r = await window.storage.get('fct_apikey');
    if(r && r.value) _apiKey = r.value;
  }catch(e){}
}

// ═══════════════════════════════════════
// SIDEBAR
// ═══════════════════════════════════════
function renderSidebar(){
  const list = document.getElementById('athlete-list');
  const keys = Object.keys(_programs);
  if(!keys.length){
    list.innerHTML = '<div style="padding:14px;font-family:var(--mono);font-size:9px;color:var(--text3);">No programs yet.</div>';
    return;
  }
  list.innerHTML = keys.map(k => {
    const p = _programs[k];
    const active = k === _activeKey;
    const phase = (p.phases||[])[((p.week||1)-1)] || '';
    return `<div class="ath-item${active?' active':''}" onclick="loadProgram('${k}')">
      <div class="ath-item-name">${p.first} ${p.last}</div>
      <div class="ath-item-meta">${p.sport||''}</div>
      <div class="ath-item-tags">
        <span class="ath-tag">W${p.week||1}</span>
        ${phase?`<span class="ath-tag good">${phase.split(' ')[0]}</span>`:''}
        ${p.achillesNote?`<span class="ath-tag warn">Achilles</span>`:''}
      </div>
    </div>`;
  }).join('');
}

// ═══════════════════════════════════════
// LOAD PROGRAM
// ═══════════════════════════════════════
function loadProgram(key){
  _activeKey = key;
  renderSidebar();
  renderProgramView();
  showView('program');
  // Close sidebar on mobile
  const sb = document.getElementById('sidebar');
  if(sb.classList.contains('open')) toggleSidebar();
}

function showView(name){
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.getElementById('view-'+name).classList.add('active');
}

// ═══════════════════════════════════════
// PROGRAM VIEW
// ═══════════════════════════════════════
function p(){ return _programs[_activeKey]; }
function wk(){ return 'w' + (p().week||1); }
function dy(){ return ['a','b','c'][p().day||0]; }
const PHASES = ['Load Tolerance','Strength + Spring','Reactive COD','Season Simulation'];

function renderProgramView(){
  const prog = p();
  if(!prog) return;

  // Name + sub
  const parts = prog.first.split(' ');
  document.getElementById('pv-name').innerHTML = parts[0] + ' <span>' + prog.last + '</span>';
  document.getElementById('pv-sub').textContent = `Week ${prog.week||1} · ${(prog.phases||PHASES)[(prog.week||1)-1]||''}`;

  // Stats
  const s = prog.stats || {};
  document.getElementById('stat-speed').textContent = s.topSpeed || '—';
  document.getElementById('stat-tb').textContent = s.tbPeak || '—';
  document.getElementById('stat-bj').textContent = s.broadJump || '—';
  document.getElementById('stat-ohm').textContent = s.ohmPull || '—';

  // Week buttons
  const totalWeeks = Object.keys(prog.program||{}).length;
  document.getElementById('week-sel').innerHTML = Array.from({length:totalWeeks},(_,i)=>
    `<button class="wk-btn${(prog.week||1)===i+1?' active':''}" onclick="setWeek(${i+1})">W${i+1}</button>`
  ).join('');

  // Day tabs inside week-sel area (append)
  renderSession();
  renderEdit();
  renderOverview();
  renderNotes();
}

function setWeek(w){
  p().week = w;
  save();
  renderProgramView();
}

function setDay(d){
  p().day = d;
  save();
  renderSession();
}

// ═══════════════════════════════════════
// SESSION
// ═══════════════════════════════════════
function renderSession(){
  const prog = p();
  const blocks = (prog.program[wk()]||{})[dy()] || [];

  // Day tabs
  const dayNames = ['Speed+Lower','Upper+Tendon','Full Body'];
  let dayHTML = `<div style="display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid var(--border);background:var(--bg2);">`;
  dayNames.forEach((n,i) => {
    const active = (prog.day||0)===i;
    dayHTML += `<div style="padding:8px 6px;text-align:center;cursor:pointer;border-bottom:2px solid ${active?'var(--accent)':'transparent'};${active?'color:var(--accent);':''}" onclick="setDay(${i})">
      <div style="font-family:var(--mono);font-size:7px;letter-spacing:0.12em;text-transform:uppercase;color:${active?'var(--accent)':'var(--text3)'};">Day ${['A','B','C'][i]}</div>
      <div style="font-family:var(--disp);font-size:12px;letter-spacing:0.03em;">${n}</div>
    </div>`;
  });
  dayHTML += '</div>';

  // Insert day tabs before session blocks
  let container = document.getElementById('session-blocks');
  const existingDayTabs = document.getElementById('day-tabs-row');
  if(existingDayTabs) existingDayTabs.remove();
  const dt = document.createElement('div');
  dt.id = 'day-tabs-row';
  dt.innerHTML = dayHTML;
  container.parentNode.insertBefore(dt, container);

  // Blocks
  let html = '';
  blocks.forEach((blk, bi) => {
    const tag = blk.contrast ? '<span class="blk-tag contrast">CONTRAST</span>' :
                blk.iso ? '<span class="blk-tag iso">ISO</span>' : '';
    html += `<div class="block"><div class="blk-hdr"><div class="blk-letter">${blk.block}</div><div class="blk-title">${blk.title}</div>${tag}</div>`;
    blk.exercises.forEach((ex, ei) => {
      const key = `${wk()}-${dy()}-${bi}-${ei}`;
      const done = (prog.done||{})[key];
      html += `<div class="ex-row${done?' done':''}" onclick="toggleEx('${key}')">
        <div class="ex-check"></div>
        <div><div class="ex-name">${ex.name}</div>${ex.note?`<span class="ex-note">${ex.note}</span>`:''}</div>
        <div><div class="ex-scheme">${ex.scheme}</div>${ex.load?`<span class="ex-load">${ex.load}</span>`:''}</div>
      </div>`;
    });
    html += '</div>';
  });
  container.innerHTML = html;
  updateProgress();
  renderSessionLogs();

  // Setup AI quick buttons
  setupAIQuickBtns();
}

function toggleEx(key){
  if(!p().done) p().done = {};
  p().done[key] = !p().done[key];
  save();
  renderSession();
}

function updateProgress(){
  const prog = p();
  const blocks = (prog.program[wk()]||{})[dy()] || [];
  let total = 0, done = 0;
  blocks.forEach((blk, bi) => {
    blk.exercises.forEach((_,ei) => {
      total++;
      if((prog.done||{})[`${wk()}-${dy()}-${bi}-${ei}`]) done++;
    });
  });
  const pct = total ? Math.round(done/total*100) : 0;
  document.getElementById('prog-pct-fill').style.width = pct+'%';
  document.getElementById('prog-pct-text').textContent = `${done} / ${total}`;
}

function renderSessionLogs(){
  const logs = (p().logs||[]).slice().reverse().slice(0,4);
  document.getElementById('sesh-log-entries').innerHTML = logs.map(l =>
    `<div class="log-entry"><span class="log-ts">${l.ts}</span>${l.text}</div>`
  ).join('');
}

// ═══════════════════════════════════════
// PAIN
// ═══════════════════════════════════════
function setPain(val){
  p().pain = val;
  document.querySelectorAll('.p-btn').forEach((b,i) => {
    b.classList.remove('g','y','r');
    if(i===val) b.classList.add(val<=3?'g':val<=5?'y':'r');
  });
  const v = document.getElementById('pain-verdict');
  if(val<=3) v.textContent = '✅ Tissue tolerating load — progress COD angle as planned';
  else if(val<=5) v.textContent = '⚠️ Tissue stressed — pull back COD angle only, keep all other intensity';
  else v.textContent = '🛑 Lateral load off. Linear speed + strength full intensity. Flag Austin.';
  save();
}

// ═══════════════════════════════════════
// LOG
// ═══════════════════════════════════════
function saveLog(src){
  const id = src==='sesh' ? 'sesh-log-ta' : 'notes-log-ta';
  const ta = document.getElementById(id);
  const text = ta.value.trim();
  if(!text) return;
  const now = new Date();
  const ts = `${now.getMonth()+1}/${now.getDate()} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
  if(!p().logs) p().logs = [];
  p().logs.push({text, ts, week: p().week||1, day: dy()});
  ta.value = '';
  save();
  renderSessionLogs();
  renderNotes();
  toast('Logged');
}

// ═══════════════════════════════════════
// EDIT
// ═══════════════════════════════════════
function renderEdit(){
  const prog = p();
  const blocks = (prog.program[wk()]||{})[dy()] || [];
  let html = '';
  blocks.forEach((blk, bi) => {
    html += `<div class="edit-block">
      <div class="edit-blk-hdr"><div class="edit-blk-name">${blk.block} — ${blk.title}</div></div>`;
    blk.exercises.forEach((ex, ei) => {
      html += `<div class="edit-ex">
        <div><div class="edit-lbl">Exercise</div><input class="edit-in full" value="${esc(ex.name)}" onchange="updateEx(${bi},${ei},'name',this.value)"></div>
        <div class="edit-row">
          <div><div class="edit-lbl">Sets × Reps</div><input class="edit-in" value="${esc(ex.scheme)}" onchange="updateEx(${bi},${ei},'scheme',this.value)"></div>
          <div><div class="edit-lbl">Load</div><input class="edit-in" value="${esc(ex.load)}" onchange="updateEx(${bi},${ei},'load',this.value)"></div>
        </div>
        <div><div class="edit-lbl">Note</div><input class="edit-in full" value="${esc(ex.note)}" onchange="updateEx(${bi},${ei},'note',this.value)"></div>
        <div class="edit-actions"><button class="edit-del" onclick="deleteEx(${bi},${ei})">Remove</button></div>
      </div>`;
    });
    html += `<button class="add-ex-btn" onclick="addEx(${bi})">+ Add Exercise to Block ${blk.block}</button>`;
    html += '</div>';
  });
  document.getElementById('edit-blocks').innerHTML = html;
}

function esc(s){ return String(s||'').replace(/"/g,'&quot;').replace(/</g,'&lt;'); }

function updateEx(bi, ei, field, val){
  const blocks = (p().program[wk()]||{})[dy()];
  if(blocks && blocks[bi] && blocks[bi].exercises[ei]) blocks[bi].exercises[ei][field] = val;
}

function deleteEx(bi, ei){
  const blocks = (p().program[wk()]||{})[dy()];
  if(blocks && blocks[bi]) blocks[bi].exercises.splice(ei, 1);
  save(); renderEdit(); renderSession();
}

function addEx(bi){
  const blocks = (p().program[wk()]||{})[dy()];
  if(blocks && blocks[bi]) blocks[bi].exercises.push({name:'New Exercise',note:'',scheme:'3×10',load:''});
  save(); renderEdit(); renderSession();
}

function saveProgramEdits(){
  save();
  renderSession();
  toast('Program saved ✓');
}

// ═══════════════════════════════════════
// OVERVIEW
// ═══════════════════════════════════════
function renderOverview(){
  const prog = p();
  const phases = prog.phases || PHASES;

  // Phase grid
  document.getElementById('ov-phases').innerHTML = phases.map((ph,i) => {
    const cur = (prog.week||1) === i+1;
    const focuses = ['Tendon rebuild · Linear only','Rate of force · Reactive intro','45° cuts · Modified agility','Full intent · Lax dodges'];
    return `<div class="phase-card${cur?' cur':''}">
      <div class="pc-wk">Week ${i+1}</div>
      <div class="pc-name">${ph}</div>
      <div class="pc-focus">${focuses[i]||''}</div>
    </div>`;
  }).join('');

  // COD gate
  const cod = prog.codGate || [];
  document.getElementById('ov-cod').innerHTML = cod.map(r =>
    `<div class="ov-tr"><div class="ov-td1">${r.wk}</div><div class="ov-td2">${r.drill}<small>${r.note}</small></div></div>`
  ).join('');

  // TB loads
  const loads = prog.tbLoads || [175,185,200,205];
  document.getElementById('ov-tbloads').innerHTML = loads.map((lb,i) =>
    `<div class="tb-cell"><div class="tb-wk">W${i+1}</div><div class="tb-lb">${lb}</div></div>`
  ).join('');

  // OHM
  const ohm = prog.ohmTargets || [];
  document.getElementById('ov-ohm').innerHTML = ohm.map(r =>
    `<div class="ov-tr"><div class="ov-td1">${r.wk}</div><div class="ov-td2">${r.target}<small>${r.note||''}</small></div></div>`
  ).join('');
}

// ═══════════════════════════════════════
// NOTES
// ═══════════════════════════════════════
function renderNotes(){
  const logs = (p().logs||[]).slice().reverse();
  const list = document.getElementById('notes-list');
  if(!logs.length){ list.innerHTML = '<div style="font-family:var(--mono);font-size:9px;color:var(--text3);padding:20px 0;text-align:center;">No notes yet</div>'; return; }
  list.innerHTML = logs.map(l => {
    const t = l.text.toLowerCase();
    const type = t.includes('speed')||t.includes('mph')||t.includes('sprint') ? 'speed' :
                 t.includes('trap')||t.includes('lb')||t.includes('bench')||t.includes('pr') ? 'strength' :
                 t.includes('pain')||t.includes('burn')||t.includes('achilles')||t.includes('shot') ? 'health' :
                 l.type==='ai' ? 'ai' : '';
    return `<div class="note-card">
      <div class="note-meta">
        <span class="note-type ${type}">${type||'note'}</span>
        <span class="note-time">${l.ts} · W${l.week||'?'}</span>
      </div>
      <div class="note-text">${l.text}</div>
    </div>`;
  }).join('');
}

// ═══════════════════════════════════════
// AI
// ═══════════════════════════════════════
function setupAIQuickBtns(){
  const prog = p();
  const btns = [
    {label:'Chase shot 🔻', prompt:`Chase is exhausted/shot today. Give me a lighter version of Day ${['A','B','C'][prog.day||0]} Week ${prog.week||1} that still hits the key stimulus.`},
    {label:'Chase fired up 🔥', prompt:`Chase is feeling great and fired up. Push Day ${['A','B','C'][prog.day||0]} Week ${prog.week||1} harder. What do we add or increase?`},
    {label:'Achilles flare ⚠️', prompt:`Achilles burning on COD today. Modify Week ${prog.week||1} Day ${['A','B','C'][prog.day||0]} to reduce lateral load only — keep everything else at full intensity.`},
    {label:'Pure speed day', prompt:`Give me a pure speed day for Week ${prog.week||1}. Linear acceleration and max velocity only. No COD.`},
    {label:'Coach brief', prompt:`Give me a 3-sentence coach brief for today's session. What should I watch for with this athlete given their current phase and Achilles history?`},
    {label:'New speed PR', prompt:`Chase just hit ${prog.stats&&prog.stats.topSpeed||'19.7'} mph top speed. Update me on what to adjust in the program and what targets to reset.`},
  ];
  document.getElementById('ai-quick-btns').innerHTML = btns.map(b =>
    `<button class="ai-quick" onclick="aiQuick(\`${b.prompt.replace(/`/g,"'")}\`)">${b.label}</button>`
  ).join('');
}

function aiQuick(prompt){
  document.getElementById('ai-ta').value = prompt;
  sendAI();
}

async function sendAI(){
  const ta = document.getElementById('ai-ta');
  const text = ta.value.trim();
  if(!text) return;
  if(!_apiKey){ toast('No API key — set it in the main Brain'); return; }

  const btn = document.getElementById('ai-send-btn');
  btn.disabled = true; btn.textContent = 'Thinking...';

  const wrap = document.getElementById('ai-resp-wrap');
  const resp = document.getElementById('ai-resp-text');
  wrap.style.display = 'block';
  resp.innerHTML = '<div class="ai-thinking"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>';

  const prog = p();
  const blocks = (prog.program[wk()]||{})[dy()] || [];
  const sessionSummary = blocks.map(b =>
    `${b.block}: ${b.exercises.map(e=>`${e.name} ${e.scheme}${e.load?' '+e.load:''}`).join(', ')}`
  ).join('\n');

  const system = `You are Coach Brain inside FitClub CT's athlete program system for ${prog.first} ${prog.last}.

ATHLETE PROFILE:
- Sport: ${prog.sport||''} · ${prog.position||''}
- Top Speed: ${prog.stats&&prog.stats.topSpeed||'?'} mph
- Trap Bar Peak: ${prog.stats&&prog.stats.tbPeak||'?'} lb (capped at ${(prog.tbLoads||[205])[3]||205} this block)
- Broad Jump: ${prog.stats&&prog.stats.broadJump||'?'}
- OHM Pull: ${prog.stats&&prog.stats.ohmPull||'?'} lb
- Current: Week ${prog.week||1} — ${(prog.phases||PHASES)[(prog.week||1)-1]||''}

${prog.achillesNote||''}

TODAY (W${prog.week||1} Day ${['A','B','C'][prog.day||0]}):
${sessionSummary}

Be direct, specific, coach language. Mobile tool — keep it concise.`;

  try{
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method:'POST',
      headers:{
        'Content-Type':'application/json',
        'anthropic-version':'2023-06-01',
        'anthropic-dangerous-direct-browser-access':'true',
        'x-api-key': _apiKey
      },
      body: JSON.stringify({
        model: MODEL,
        max_tokens: 800,
        system,
        messages:[{role:'user', content:text}]
      })
    });
    const d = await res.json();
    const answer = (d.content&&d.content.find(c=>c.type==='text')&&d.content.find(c=>c.type==='text').text) || 'No response.';
    _lastAIResp = answer;
    resp.textContent = answer;
  } catch(e){
    resp.textContent = 'Error: '+e.message;
  }

  btn.disabled = false; btn.textContent = 'Ask Coach Brain';
}

function applyAIToLog(){
  if(!_lastAIResp) return;
  const now = new Date();
  const ts = `${now.getMonth()+1}/${now.getDate()} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
  if(!p().logs) p().logs = [];
  p().logs.push({text:'[AI] '+_lastAIResp.slice(0,300), ts, week:p().week||1, day:dy(), type:'ai'});
  save(); renderNotes(); toast('Added to log ✓');
}

// ═══════════════════════════════════════
// STAT EDIT
// ═══════════════════════════════════════
function openStatEdit(field, label){
  _statEditField = field;
  document.getElementById('stat-modal-title').textContent = 'Update: '+label;
  document.getElementById('stat-modal-input').value = (p().stats||{})[field]||'';
  openModal('stat-modal');
  setTimeout(()=>document.getElementById('stat-modal-input').focus(), 100);
}

function saveStatEdit(){
  if(!_statEditField) return;
  if(!p().stats) p().stats = {};
  p().stats[_statEditField] = document.getElementById('stat-modal-input').value.trim();
  save();
  renderProgramView();
  closeModal('stat-modal');
  toast('Updated ✓');
}

// ═══════════════════════════════════════
// ADD PROGRAM
// ═══════════════════════════════════════
function addProgram(){
  const key = (document.getElementById('np-key').value.trim()||'').toLowerCase().replace(/\s+/g,'_');
  const first = document.getElementById('np-first').value.trim();
  const last = document.getElementById('np-last').value.trim();
  const msg = document.getElementById('np-msg');

  if(!key||!first||!last){ msg.textContent='Name and key required.'; return; }

  const jsonRaw = document.getElementById('np-json').value.trim();
  let extra = {};
  if(jsonRaw){
    try{ extra = JSON.parse(jsonRaw); }
    catch(e){ msg.textContent='Invalid JSON — check formatting.'; return; }
  }

  _programs[key] = {
    key, first, last,
    sport: document.getElementById('np-sport').value.trim(),
    position: document.getElementById('np-pos').value.trim(),
    stats: extra.stats || {},
    week: 1, day: 0,
    done: {}, pain: null, logs: [],
    phases: extra.phases || PHASES,
    tbLoads: extra.tbLoads || [175,185,200,205],
    codGate: extra.codGate || [],
    ohmTargets: extra.ohmTargets || [],
    program: extra.program || {w1:{a:[],b:[],c:[]}},
    ...extra
  };

  save();
  closeModal('m-new-prog');
  renderSidebar();
  loadProgram(key);
  toast(`${first} ${last} added ✓`);
}

// ═══════════════════════════════════════
// NAV
// ═══════════════════════════════════════
function showPV(name, tab){
  document.querySelectorAll('.pv').forEach(v => v.classList.remove('active'));
  document.querySelectorAll('.pn-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('pv-'+name).classList.add('active');
  if(tab) tab.classList.add('active');
  if(name==='edit') renderEdit();
  if(name==='overview') renderOverview();
  if(name==='notes') renderNotes();
}

function toggleSidebar(){
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sidebar-overlay').classList.toggle('open');
}

function openModal(id){ document.getElementById(id).classList.add('open'); }
function closeModal(id){ document.getElementById(id).classList.remove('open'); }
document.addEventListener('click', e => { if(e.target.classList.contains('mo')) e.target.classList.remove('open'); });

let _tt;
function toast(m){
  const t = document.getElementById('toast');
  t.textContent = m; t.classList.add('show');
  clearTimeout(_tt); _tt = setTimeout(()=>t.classList.remove('show'), 2600);
}

// ═══════════════════════════════════════
// INIT
// ═══════════════════════════════════════
(async function init(){
  loadAll();
  await loadApiKey();
  renderSidebar();
  // Auto-load Chase on first visit
  if(!_activeKey && _programs['chase_powers']){
    loadProgram('chase_powers');
  }
})();
</script>
