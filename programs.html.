<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>FitClub CT — Programs</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Mono:wght@400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#090909;--bg2:#111;--bg3:#181818;--bg4:#1f1f1f;
  --border:#222;--border2:#2c2c2c;
  --accent:#b8ff57;--accent2:#9ce630;--adim:rgba(184,255,87,.08);
  --text:#efefef;--text2:#888;--text3:#444;
  --red:#ff4d4d;--orange:#ff8c42;--blue:#42a5ff;--green:#2d7a4f;
  --gold:#c9a84c;--gold2:#e8c97a;
  --mono:'DM Mono',ui-monospace,monospace;
  --disp:'Bebas Neue',Impact,sans-serif;
  --sans:'DM Sans',sans-serif;
  --r:4px;--nav:56px;
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;background:var(--bg);color:var(--text);font-family:var(--sans);font-weight:300;font-size:13px;line-height:1.5;overflow:hidden;}
#shell{display:flex;flex-direction:column;height:100dvh;overflow:hidden;}

/* TOPBAR */
#topbar{height:48px;min-height:48px;background:var(--bg2);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 16px;flex-shrink:0;padding-top:env(safe-area-inset-top,0);}
.tb-logo{font-family:var(--disp);font-size:16px;letter-spacing:3px;color:var(--accent);}
.tb-sub{font-size:8px;color:var(--text3);letter-spacing:2px;text-transform:uppercase;margin-left:8px;}
.tb-right{display:flex;align-items:center;gap:8px;}
.tb-link{font-family:var(--mono);font-size:9px;letter-spacing:1px;text-transform:uppercase;color:var(--text3);text-decoration:none;padding:5px 10px;border:1px solid var(--border);border-radius:var(--r);}
.tb-link:hover{color:var(--accent);border-color:var(--accent);}

/* MAIN LAYOUT */
#main{display:flex;flex:1;overflow:hidden;}

/* SIDEBAR */
#sidebar{width:220px;min-width:220px;background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden;flex-shrink:0;}
#sidebar-hdr{padding:14px 14px 10px;border-bottom:1px solid var(--border);flex-shrink:0;}
.sh-title{font-family:var(--disp);font-size:22px;letter-spacing:2px;line-height:1;}
.sh-sub{font-size:8px;color:var(--text3);letter-spacing:2px;text-transform:uppercase;margin-top:3px;}
.sh-actions{display:flex;gap:6px;margin-top:10px;}
#athlete-list{flex:1;overflow-y:auto;padding:8px;}
.ath-item{padding:9px 11px;border:1px solid var(--border);border-radius:var(--r);margin-bottom:5px;cursor:pointer;transition:all .12s;background:var(--bg3);}
.ath-item:hover,.ath-item.active{border-color:var(--accent);background:var(--adim);}
.ath-item-name{font-family:var(--disp);font-size:15px;letter-spacing:0.03em;line-height:1;}
.ath-item-meta{font-family:var(--mono);font-size:8px;letter-spacing:0.1em;color:var(--text3);text-transform:uppercase;margin-top:2px;}
.ath-item-tags{display:flex;gap:3px;flex-wrap:wrap;margin-top:4px;}
.ath-tag{font-family:var(--mono);font-size:7px;letter-spacing:0.08em;text-transform:uppercase;padding:1px 5px;border-radius:2px;border:1px solid var(--border2);color:var(--text3);}
.ath-tag.warn{border-color:rgba(255,140,66,.4);color:var(--orange);}
.ath-tag.good{border-color:rgba(184,255,87,.3);color:var(--accent);}

/* CONTENT */
#content{flex:1;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;background:var(--bg);}
.view{display:none;height:100%;}
.view.active{display:block;}

/* EMPTY STATE */
.empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:12px;padding:40px;}
.empty-icon{font-size:48px;opacity:.3;}
.empty-label{font-family:var(--mono);font-size:10px;letter-spacing:0.15em;text-transform:uppercase;color:var(--text3);}

/* PROGRAM TOPBAR */
.prog-topbar{position:sticky;top:0;z-index:50;background:var(--bg2);border-bottom:1px solid var(--border);padding:10px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
.prog-ath-name{font-family:var(--disp);font-size:26px;letter-spacing:0.04em;line-height:1;}
.prog-ath-name span{color:var(--accent);}
.prog-ath-sub{font-family:var(--mono);font-size:8px;letter-spacing:0.14em;text-transform:uppercase;color:var(--text3);margin-top:2px;}
.week-sel{display:flex;gap:4px;flex-wrap:wrap;}
.wk-btn{font-family:var(--mono);font-size:9px;font-weight:500;padding:4px 9px;border:1px solid var(--border);border-radius:var(--r);background:transparent;color:var(--text3);cursor:pointer;transition:all .12s;}
.wk-btn.active{background:var(--accent);border-color:var(--accent);color:#000;}

/* STAT STRIP */
.stat-strip{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--border);background:var(--bg2);}
.sc{padding:8px 10px;border-right:1px solid var(--border);text-align:center;}
.sc:last-child{border-right:none;}
.sc-l{font-family:var(--mono);font-size:7px;letter-spacing:0.12em;text-transform:uppercase;color:var(--text3);margin-bottom:2px;}
.sc-v{font-family:var(--disp);font-size:18px;line-height:1;color:var(--accent);cursor:pointer;}
.sc-v:hover{color:var(--gold);}

/* NAV TABS inside program */
.prog-nav{display:flex;background:var(--bg2);border-bottom:1px solid var(--border);overflow-x:auto;scrollbar-width:none;}
.prog-nav::-webkit-scrollbar{display:none;}
.pn-tab{padding:9px 14px;font-family:var(--mono);font-size:9px;letter-spacing:0.15em;text-transform:uppercase;color:var(--text3);cursor:pointer;white-space:nowrap;border-bottom:2px solid transparent;flex-shrink:0;}
.pn-tab.active{color:var(--accent);border-bottom-color:var(--accent);}

/* PROGRAM VIEWS */
.pv{display:none;padding:14px 16px 40px;}
.pv.active{display:block;}

/* BLOCKS */
.block{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);margin-bottom:10px;overflow:hidden;}
.blk-hdr{padding:7px 12px;background:var(--bg4);display:flex;align-items:center;gap:8px;}
.blk-letter{font-family:var(--disp);font-size:18px;color:var(--accent);line-height:1;}
.blk-title{font-family:var(--mono);font-size:8px;letter-spacing:0.15em;text-transform:uppercase;color:var(--text3);}
.blk-tag{font-family:var(--mono);font-size:7px;padding:2px 6px;border-radius:2px;margin-left:auto;}
.blk-tag.contrast{background:var(--blue);color:#fff;}
.blk-tag.iso{background:var(--accent);color:#000;}

/* EXERCISE ROW */
.ex-row{padding:9px 12px;border-top:1px solid var(--border);display:grid;grid-template-columns:1fr auto;gap:8px;align-items:start;background:var(--bg3);cursor:pointer;transition:background .1s;position:relative;}
.ex-row.done{background:var(--bg2);opacity:.45;}
.ex-row.done .ex-name{text-decoration:line-through;}
.ex-check{position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--green);opacity:0;transition:opacity .2s;}
.ex-row.done .ex-check{opacity:1;}
.ex-name{font-size:12px;font-weight:400;line-height:1.3;}
.ex-note{font-size:10px;color:var(--text3);font-style:italic;margin-top:1px;display:block;}
.ex-scheme{font-family:var(--mono);font-size:10px;font-weight:500;color:var(--gold2);white-space:nowrap;text-align:right;}
.ex-load{font-family:var(--mono);font-size:9px;color:var(--accent);display:block;text-align:right;margin-top:1px;}

/* PROGRESS */
.prog-wrap{margin:10px 16px 0;background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:8px 12px;}
.prog-top{display:flex;justify-content:space-between;align-items:center;font-family:var(--mono);font-size:8px;letter-spacing:0.12em;text-transform:uppercase;color:var(--text3);margin-bottom:5px;}
.prog-track{height:3px;background:var(--border);border-radius:2px;overflow:hidden;}
.prog-fill{height:100%;background:var(--accent);border-radius:2px;transition:width .3s;}

/* PAIN MONITOR */
.pain-wrap{margin:10px 16px 0;background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);overflow:hidden;}
.pain-hdr{padding:7px 12px;background:var(--bg4);font-family:var(--mono);font-size:8px;letter-spacing:0.15em;text-transform:uppercase;color:var(--text3);}
.pain-btns{display:flex;flex-wrap:wrap;gap:4px;padding:8px 12px;}
.p-btn{font-family:var(--mono);font-size:10px;font-weight:500;padding:5px 9px;border-radius:var(--r);border:1px solid var(--border);background:transparent;color:var(--text);cursor:pointer;transition:all .12s;}
.p-btn.g{background:var(--green);border-color:var(--green);color:#fff;}
.p-btn.y{background:var(--orange);border-color:var(--orange);color:#fff;}
.p-btn.r{background:var(--red);border-color:var(--red);color:#fff;}
.pain-verdict{padding:0 12px 9px;font-size:10px;color:var(--text3);min-height:14px;line-height:1.4;}

/* LOG */
.log-wrap{margin:10px 16px 0;background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:11px 12px;}
.log-title{font-family:var(--mono);font-size:8px;letter-spacing:0.15em;text-transform:uppercase;color:var(--accent);margin-bottom:7px;}
.log-ta{width:100%;background:var(--bg3);border:1px solid var(--border2);border-radius:var(--r);color:var(--text);font-family:var(--sans);font-size:13px;padding:7px 10px;resize:none;height:52px;outline:none;}
.log-ta:focus{border-color:var(--accent);}
.log-save{margin-top:6px;width:100%;padding:7px;background:var(--accent);color:#000;font-family:var(--mono);font-size:9px;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;border:none;border-radius:var(--r);cursor:pointer;}
.log-entries{margin-top:7px;display:flex;flex-direction:column;gap:3px;}
.log-entry{font-size:10px;color:var(--text3);padding:3px 0;border-bottom:1px solid var(--border);line-height:1.4;}
.log-entry:last-child{border-bottom:none;}
.log-ts{font-family:var(--mono);font-size:8px;color:var(--text3);margin-right:5px;}

/* EDIT PAGE */
.edit-block{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);margin-bottom:10px;overflow:hidden;}
.edit-blk-hdr{padding:8px 12px;background:var(--bg4);display:flex;justify-content:space-between;align-items:center;}
.edit-blk-name{font-family:var(--disp);font-size:15px;color:var(--accent);letter-spacing:0.04em;}
.edit-ex{padding:10px 12px;border-top:1px solid var(--border);background:var(--bg3);display:flex;flex-direction:column;gap:5px;}
.edit-row{display:grid;grid-template-columns:1fr 1fr;gap:5px;}
.edit-lbl{font-family:var(--mono);font-size:7px;letter-spacing:0.12em;text-transform:uppercase;color:var(--text3);margin-bottom:2px;}
.edit-in{background:var(--bg);border:1px solid var(--border2);border-radius:var(--r);color:var(--text);font-family:var(--sans);font-size:12px;padding:5px 8px;outline:none;width:100%;}
.edit-in:focus{border-color:var(--accent);}
.edit-in.full{grid-column:1/-1;}
.edit-actions{display:flex;gap:5px;justify-content:flex-end;margin-top:3px;}
.edit-del{font-family:var(--mono);font-size:8px;padding:3px 7px;border:1px solid rgba(255,77,77,.4);border-radius:var(--r);background:transparent;color:var(--red);cursor:pointer;}
.add-ex-btn{margin:0 16px 8px;width:calc(100% - 32px);padding:8px;border:1px dashed var(--border2);border-radius:var(--r);background:transparent;color:var(--text3);font-family:var(--mono);font-size:9px;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;}
.add-ex-btn:hover{border-color:var(--accent);color:var(--accent);}
.save-prog-btn{margin:10px 16px;width:calc(100% - 32px);padding:10px;background:var(--accent);color:#000;font-family:var(--mono);font-size:10px;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;border:none;border-radius:var(--r);cursor:pointer;}

/* AI PAGE */
.ai-quick-btns{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:10px;}
.ai-quick{font-family:var(--mono);font-size:8px;letter-spacing:0.08em;padding:5px 9px;border:1px solid var(--border);border-radius:var(--r);background:transparent;color:var(--text3);cursor:pointer;transition:all .12s;}
.ai-quick:hover{border-color:var(--accent);color:var(--accent);}
.ai-input-wrap{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:11px 12px;margin-bottom:10px;}
.ai-ta{width:100%;background:var(--bg3);border:1px solid var(--border2);border-radius:var(--r);color:var(--text);font-family:var(--sans);font-size:13px;padding:7px 10px;resize:none;height:72px;outline:none;}
.ai-ta:focus{border-color:var(--accent);}
.ai-send{margin-top:7px;width:100%;padding:9px;background:var(--accent);color:#000;font-family:var(--mono);font-size:9px;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;border:none;border-radius:var(--r);cursor:pointer;}
.ai-send:disabled{opacity:.5;}
.ai-resp-wrap{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);overflow:hidden;}
.ai-resp-hdr{padding:8px 12px;background:var(--bg4);display:flex;justify-content:space-between;align-items:center;font-family:var(--mono);font-size:8px;letter-spacing:0.15em;text-transform:uppercase;color:var(--accent);}
.ai-apply{font-family:var(--mono);font-size:8px;padding:3px 7px;border:1px solid var(--green);border-radius:var(--r);background:transparent;color:#2d7a4f;cursor:pointer;}
.ai-resp-text{padding:12px;font-size:12px;line-height:1.7;color:var(--text2);white-space:pre-wrap;}
.ai-thinking{display:flex;gap:4px;align-items:center;font-family:var(--mono);font-size:10px;color:var(--text3);}
.dot{width:5px;height:5px;border-radius:50%;background:var(--accent);animation:pulse 1s infinite;}
.dot:nth-child(2){animation-delay:.2s;}.dot:nth-child(3){animation-delay:.4s;}
@keyframes pulse{0%,80%,100%{opacity:.2}40%{opacity:1}}

/* OVERVIEW */
.ov-section{margin-bottom:16px;}
.ov-label{font-family:var(--mono);font-size:8px;letter-spacing:0.15em;text-transform:uppercase;color:var(--accent);margin-bottom:8px;}
.phase-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:7px;}
.phase-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:10px 11px;}
.phase-card.cur{border-color:var(--accent);}
.pc-wk{font-family:var(--mono);font-size:7px;letter-spacing:0.12em;text-transform:uppercase;color:var(--text3);margin-bottom:3px;}
.pc-name{font-family:var(--disp);font-size:16px;letter-spacing:0.03em;line-height:1;}
.phase-card.cur .pc-name{color:var(--accent);}
.pc-focus{font-size:10px;color:var(--text3);margin-top:2px;}
.ov-table{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);overflow:hidden;}
.ov-tr{display:grid;grid-template-columns:44px 1fr;border-bottom:1px solid var(--border);}
.ov-tr:last-child{border-bottom:none;}
.ov-td1{padding:8px 10px;font-family:var(--disp);font-size:14px;color:var(--accent);border-right:1px solid var(--border);}
.ov-td2{padding:8px 10px;font-size:11px;line-height:1.4;}
.ov-td2 small{color:var(--text3);font-style:italic;display:block;font-size:9px;margin-top:1px;}
.tb-row-grid{display:grid;grid-template-columns:repeat(4,1fr);background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);overflow:hidden;}
.tb-cell{padding:9px;text-align:center;border-right:1px solid var(--border);}
.tb-cell:last-child{border-right:none;}
.tb-wk{font-family:var(--mono);font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:var(--text3);margin-bottom:2px;}
.tb-lb{font-family:var(--disp);font-size:20px;color:var(--accent);line-height:1;}

/* NOTES */
.note-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);padding:9px 11px;margin-bottom:7px;}
.note-meta{display:flex;justify-content:space-between;align-items:center;margin-bottom:3px;}
.note-type{font-family:var(--mono);font-size:7px;letter-spacing:0.1em;text-transform:uppercase;padding:2px 5px;border-radius:2px;background:var(--bg4);color:var(--text3);}
.note-type.speed{background:var(--blue);color:#fff;}
.note-type.strength{background:var(--accent);color:#000;}
.note-type.health{background:var(--red);color:#fff;}
.note-type.ai{background:#4a1e8c;color:#fff;}
.note-time{font-family:var(--mono);font-size:8px;color:var(--text3);}
.note-text{font-size:12px;line-height:1.5;}

/* MODAL */
.mo{position:fixed;inset:0;background:rgba(0,0,0,.82);z-index:900;display:none;align-items:flex-end;justify-content:center;}
.mo.open{display:flex;}
.modal{background:var(--bg2);border-top:1px solid var(--border2);border-radius:12px 12px 0 0;width:100%;max-width:520px;max-height:85vh;overflow-y:auto;padding:18px 18px calc(18px + env(safe-area-inset-bottom,0));}
.m-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;}
.m-title{font-family:var(--disp);font-size:20px;letter-spacing:2px;}
.m-close{cursor:pointer;color:var(--text3);font-size:18px;padding:4px;}
.m-foot{display:flex;justify-content:flex-end;gap:7px;margin-top:12px;padding-top:10px;border-top:1px solid var(--border);}
@media(min-width:600px){.mo{align-items:center;padding:16px;}.modal{border-radius:8px;border:1px solid var(--border2);}}

/* BUTTONS */
.btn{padding:6px 11px;font-family:var(--mono);font-size:8px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;border:1px solid var(--border2);background:var(--bg3);color:var(--text3);border-radius:var(--r);transition:all .12s;display:inline-flex;align-items:center;gap:5px;white-space:nowrap;min-height:32px;}
.btn:hover{border-color:var(--accent);color:var(--accent);}
.btn-primary{background:var(--accent);color:#000;border-color:var(--accent);font-weight:700;}
.btn-primary:hover{background:var(--accent2);border-color:var(--accent2);color:#000;}
.btn-sm{padding:4px 8px;font-size:7px;min-height:26px;}
.fg{margin-bottom:9px;}
label{font-size:7px;letter-spacing:2px;color:var(--text3);text-transform:uppercase;display:block;margin-bottom:3px;}
input,select,textarea{background:var(--bg3);border:1px solid var(--border2);color:var(--text);font-family:var(--mono);font-size:14px;padding:7px 10px;border-radius:var(--r);outline:none;width:100%;-webkit-appearance:none;}
input:focus,select:focus,textarea:focus{border-color:var(--accent);}

/* STAT EDIT MODAL */
#stat-modal .modal{max-width:380px;}

/* TOAST */
#toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%) translateY(60px);background:var(--accent);color:#000;font-family:var(--mono);font-size:9px;letter-spacing:2px;text-transform:uppercase;font-weight:700;padding:7px 16px;border-radius:20px;z-index:9999;opacity:0;transition:all .22s;pointer-events:none;white-space:nowrap;}
#toast.show{transform:translateX(-50%) translateY(0);opacity:1;}

/* MOBILE SIDEBAR TOGGLE */
@media(max-width:640px){
  #sidebar{position:fixed;top:48px;left:0;bottom:0;z-index:200;transform:translateX(-100%);transition:transform .2s;width:240px;}
  #sidebar.open{transform:translateX(0);}
  #sidebar-overlay{display:none;position:fixed;inset:0;top:48px;background:rgba(0,0,0,.6);z-index:199;}
  #sidebar-overlay.open{display:block;}
  #content{width:100%;}
  .prog-topbar{flex-direction:column;align-items:flex-start;}
}

::-webkit-scrollbar{width:3px;height:3px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px;}
</style>
</head>
<body>
<div id="shell">

<!-- TOPBAR -->
<div id="topbar">
  <div style="display:flex;align-items:center;">
    <button id="menu-btn" onclick="toggleSidebar()" style="background:transparent;border:none;color:var(--text3);font-size:18px;cursor:pointer;margin-right:10px;padding:4px;">☰</button>
    <span class="tb-logo">FITCLUB CT</span>
    <span class="tb-sub" style="margin-left:8px;">Programs</span>
  </div>
  <div class="tb-right">
    <a href="index.html" class="tb-link">⚡ Brain</a>
    <button class="btn btn-primary btn-sm" onclick="openModal('m-new-prog')">+ Program</button>
  </div>
</div>

<div id="main">

<!-- SIDEBAR OVERLAY (mobile) -->
<div id="sidebar-overlay" onclick="toggleSidebar()"></div>

<!-- SIDEBAR -->
<div id="sidebar">
  <div id="sidebar-hdr">
    <div class="sh-title">ATHLETES</div>
    <div class="sh-sub">Tap to load program</div>
    <div class="sh-actions">
      <button class="btn btn-sm btn-primary" onclick="openModal('m-new-prog');toggleSidebar()">+ Add</button>
    </div>
  </div>
  <div id="athlete-list"></div>
</div>

<!-- CONTENT -->
<div id="content">

  <!-- EMPTY VIEW -->
  <div class="view active" id="view-empty">
    <div class="empty-state">
      <div class="empty-icon">📋</div>
      <div class="empty-label">Select an athlete or add a program</div>
      <button class="btn btn-primary" onclick="openModal('m-new-prog')">+ New Program</button>
    </div>
  </div>

  <!-- PROGRAM VIEW -->
  <div class="view" id="view-program">

    <!-- Program Topbar -->
    <div class="prog-topbar">
      <div>
        <div class="prog-ath-name" id="pv-name">ATHLETE</div>
        <div class="prog-ath-sub" id="pv-sub">Week 1 · Phase</div>
      </div>
      <div class="week-sel" id="week-sel"></div>
    </div>

    <!-- Stat Strip -->
    <div class="stat-strip">
      <div class="sc"><div class="sc-l">Top Speed</div><div class="sc-v" id="stat-speed" onclick="openStatEdit('topSpeed','Top Speed (mph)')">—</div></div>
      <div class="sc"><div class="sc-l">TB Peak</div><div class="sc-v" id="stat-tb" onclick="openStatEdit('tbPeak','Trap Bar Peak (lb)')">—</div></div>
      <div class="sc"><div class="sc-l">Broad Jmp</div><div class="sc-v" id="stat-bj" onclick="openStatEdit('broadJump','Broad Jump')">—</div></div>
      <div class="sc"><div class="sc-l">OHM Pull</div><div class="sc-v" id="stat-ohm" onclick="openStatEdit('ohmPull','OHM Pull (lb)')">—</div></div>
    </div>

    <!-- Program Nav -->
    <div class="prog-nav">
      <div class="pn-tab active" onclick="showPV('session',this)">⚡ Session</div>
      <div class="pn-tab" onclick="showPV('edit',this)">✏️ Edit</div>
      <div class="pn-tab" onclick="showPV('ai',this)">🧠 AI</div>
      <div class="pn-tab" onclick="showPV('overview',this)">📋 Overview</div>
      <div class="pn-tab" onclick="showPV('notes',this)">📝 Log</div>
    </div>

    <!-- SESSION VIEW -->
    <div class="pv active" id="pv-session">
      <div class="prog-wrap">
        <div class="prog-top"><span>Session Progress</span><span id="prog-pct-text">0 / 0</span></div>
        <div class="prog-track"><div class="prog-fill" id="prog-pct-fill" style="width:0%"></div></div>
      </div>
      <div id="session-blocks" style="padding:0 16px;margin-top:2px;"></div>
      <div class="pain-wrap" style="margin-bottom:10px;">
        <div class="pain-hdr">Achilles / COD Tissue Check</div>
        <div class="pain-btns">
          <button class="p-btn" onclick="setPain(0)">0</button>
          <button class="p-btn" onclick="setPain(1)">1</button>
          <button class="p-btn" onclick="setPain(2)">2</button>
          <button class="p-btn" onclick="setPain(3)">3</button>
          <button class="p-btn" onclick="setPain(4)">4</button>
          <button class="p-btn" onclick="setPain(5)">5</button>
          <button class="p-btn" onclick="setPain(6)">6+</button>
        </div>
        <div class="pain-verdict" id="pain-verdict">Rate pain during COD or Achilles loading</div>
      </div>
      <div class="log-wrap" style="margin-bottom:20px;">
        <div class="log-title">Session Log</div>
        <textarea class="log-ta" id="sesh-log-ta" placeholder="Chase hit 19.8 · trap bar felt easy · Achilles quiet..."></textarea>
        <button class="log-save" onclick="saveLog('sesh')">Save Note</button>
        <div class="log-entries" id="sesh-log-entries"></div>
      </div>
    </div>

    <!-- EDIT VIEW -->
    <div class="pv" id="pv-edit">
      <div style="padding:10px 0 6px;font-family:var(--mono);font-size:8px;letter-spacing:0.15em;text-transform:uppercase;color:var(--text3);">Tap any field to edit · changes save instantly</div>
