// PATCH: Override buildWeekPrompt to use Brain context router
// ═══════════════════════════════════════════════════════
const _origBuildWeekPrompt = window.buildWeekPrompt;
window.buildWeekPrompt = function(wk,totalWeeks,ath,opts,prevWeekData,actuals){
  // Call original but swap out COACHING_BIBLE for brain context
  const brainCtx = getContextualBrain('program '+opts.goal+' '+ath.sport+' strength speed block');
  // The original function uses COACHING_BIBLE as first line of the return string
  // We intercept by temporarily overriding COACHING_BIBLE
  const origBible = window.COACHING_BIBLE || '';
  // Replace by calling original and then swapping
  if(_origBuildWeekPrompt) {
    const result = _origBuildWeekPrompt.apply(this, arguments);
    // Replace COACHING_BIBLE portion with brain context
    if(result && origBible) {
      return result.replace(origBible, brainCtx);
    }
    return brainCtx + '\n\n' + (result || '');
  }
  return brainCtx;
};

